---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import Badge from "../../../components/Badge.astro";
import { site } from "../../../config/site";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const categories = [...new Set(allPosts.map((p) => p.data.category))];

  return categories.map((category) => ({
    params: { category: category.toLowerCase() },
    props: {
      categorySlug: category.toLowerCase(),
      categoryName: category,
    },
  }));
}

const { categorySlug, categoryName } = Astro.props;

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const filtered = allPosts.filter(
  (p) => p.data.category.toLowerCase() === categorySlug
);

const perPage = site.postsPerPage;
const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
const currentPage = 1;
const posts = filtered.slice(0, perPage);

const displayName = categoryName;

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<BaseLayout
  title={`${displayName} — ${site.name}`}
  description={`Tulisan kategori ${displayName}.`}
>
  <section class="bg-grid section">
    <div class="container-brutal">
      <a
        href="/blog/category/"
        class="inline-flex items-center gap-1 font-mono text-xs font-bold uppercase tracking-wide text-[var(--color-ink)]/60 no-underline mb-6 hover:text-[var(--color-ink)]"
      >
        ← Semua kategori
      </a>

      <Badge color="lime" class="mb-4">{displayName}</Badge>
      <h1 class="text-5xl md:text-6xl font-black tracking-tight mb-3">
        {displayName}
      </h1>
      <p class="text-lg text-[var(--color-ink)]/70 max-w-xl mb-10">
        {filtered.length} tulisan dalam kategori ini
        {totalPages > 1 && ` · Halaman ${currentPage} dari ${totalPages}`}
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.id}/`}
              category={post.data.category}
              date={formatDate(post.data.pubDate)}
              author={post.data.author}
              image={post.data.image}
              searchText={(post.data.tags || []).join(" ")}
            />
          ))
        }
      </div>

      {
        totalPages > 1 && (
          <nav class="mt-12 flex items-center justify-center gap-3" aria-label="Pagination">
            <span class="btn-brutal btn-secondary px-4 py-2 text-sm opacity-40 pointer-events-none">
              ← Prev
            </span>
            <span class="font-mono text-sm font-bold">
              {currentPage} / {totalPages}
            </span>
            <a
              href={`/blog/category/${categorySlug}/page/2/`}
              class="btn-brutal btn-secondary px-4 py-2 text-sm no-underline text-[var(--color-ink)]"
            >
              Next →
            </a>
          </nav>
        )
      }
    </div>
  </section>
</BaseLayout>