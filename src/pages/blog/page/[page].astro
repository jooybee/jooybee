---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import Badge from "../../../components/Badge.astro";
import SearchBox from "../../../components/SearchBox.astro";
import { site } from "../../../config/site";

export async function getStaticPaths() {
  const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const perPage = site.postsPerPage;
  const totalPages = Math.max(1, Math.ceil(allPosts.length / perPage));

  // page 1 is /blog — only generate 2..N
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    const start = (page - 1) * perPage;
    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        posts: allPosts.slice(start, start + perPage),
        allCount: allPosts.length,
      },
    };
  });
}

const { page, totalPages, posts, allCount } = Astro.props;

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<BaseLayout title={`Blog — page ${page} — ${site.name}`} description={site.description}>
  <section class="bg-grid section">
    <div class="container-brutal">
      <Badge color="lime" class="mb-4">The blunt list</Badge>
      <h1 class="text-5xl md:text-6xl font-black tracking-tight mb-3">
        Words, <span class="mark">no filler.</span>
      </h1>
      <p class="text-lg text-[var(--color-ink)]/70 max-w-xl mb-8">
        Page {page} of {totalPages} · {allCount} posts total
      </p>

      <SearchBox class="max-w-md mb-10" placeholder="Search title, tag, author…" />

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.id}/`}
              category={post.data.category}
              date={formatDate(post.data.pubDate)}
              author={post.data.author}
              image={post.data.image}
              searchText={(post.data.tags || []).join(" ")}
            />
          ))
        }
      </div>

      <p id="search-empty" class="hidden mt-8 font-mono text-sm text-[var(--color-ink)]/60">
        No posts match that search.
      </p>

      <nav class="mt-12 flex items-center justify-center gap-3" aria-label="Pagination">
        {
          page > 2 ? (
            <a
              href={`/blog/page/${page - 1}/`}
              class="btn-brutal btn-secondary px-4 py-2 text-sm no-underline text-[var(--color-ink)]"
            >
              ← Prev
            </a>
          ) : (
            <a
              href="/blog/"
              class="btn-brutal btn-secondary px-4 py-2 text-sm no-underline text-[var(--color-ink)]"
            >
              ← Prev
            </a>
          )
        }
        <span class="font-mono text-sm font-bold">
          {page} / {totalPages}
        </span>
        {
          page < totalPages ? (
            <a
              href={`/blog/page/${page + 1}/`}
              class="btn-brutal btn-secondary px-4 py-2 text-sm no-underline text-[var(--color-ink)]"
            >
              Next →
            </a>
          ) : (
            <span class="btn-brutal btn-secondary px-4 py-2 text-sm opacity-40 pointer-events-none">
              Next →
            </span>
          )
        }
      </nav>
    </div>
  </section>
</BaseLayout>
