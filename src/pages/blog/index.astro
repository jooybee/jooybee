---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import Badge from "../../components/Badge.astro";
import SearchBox from "../../components/SearchBox.astro";
import { site } from "../../config/site";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const perPage = site.postsPerPage;
const totalPages = Math.max(1, Math.ceil(allPosts.length / perPage));
const currentPage = 1;
const pagePosts = allPosts.slice(0, perPage);

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<BaseLayout title={`Blog — ${site.name}`} description={site.description}>
  <section class="bg-grid section reveal">
    <div class="container-brutal">
      <Badge color="lime" class="mb-4">Daftar bacaan.</Badge>
      <h1 class="text-5xl md:text-6xl font-black tracking-tight mb-3">
        Semua atikel, <span class="mark">penuh arti.</span>
      </h1>
      <p class="text-lg text-[var(--color-ink)]/70 max-w-xl mb-8">
        {site.description}. — {allPosts.length} posts and counting.
      </p>

      <SearchBox class="max-w-md mb-10" placeholder="Search title, tag, author…" />

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          pagePosts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.id}/`}
              category={post.data.category}
              date={formatDate(post.data.pubDate)}
              author={post.data.author}
              image={post.data.image}
              searchText={(post.data.tags || []).join(" ")}
            />
          ))
        }
      </div>

      <p id="search-empty" class="hidden mt-8 font-mono text-sm text-[var(--color-ink)]/60">
        No posts match that search.
      </p>

      {
        totalPages > 1 && (
          <nav class="mt-12 flex items-center justify-center gap-3" aria-label="Pagination">
            <span class="btn-brutal btn-secondary px-4 py-2 text-sm opacity-40 pointer-events-none">
              ← Prev
            </span>
            <span class="font-mono text-sm font-bold">
              {currentPage} / {totalPages}
            </span>
            <a
              href="/blog/page/2/"
              class="btn-brutal btn-secondary px-4 py-2 text-sm no-underline text-[var(--color-ink)]"
            >
              Next →
            </a>
          </nav>
        )
      }
    </div>
  </section>
</BaseLayout>
