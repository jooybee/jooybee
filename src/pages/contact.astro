---
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "../components/Badge.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../config/site";
---

<BaseLayout title={`Contact — ${site.name}`} description="Get in touch with JOOYBEE.">
  <section class="bg-grid section reveal">
    <div class="container-brutal">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <Badge color="lime" class="mb-4">Contact</Badge>
          <h1 class="text-5xl md:text-6xl font-black tracking-tight mb-4">
            Katakan <span class="mark">terus terang.</span>
          </h1>
          <p class="text-lg text-[var(--color-ink)]/70 max-w-md mb-6 leading-relaxed">
            Guest post, koreksi, saran, support, atau sekedar sapa — gunakan form ini.
            Saya akan baca semuanya. Saya akan balas secepatnya jika memang perlu 
          </p>
          <ul class="space-y-2 text-sm font-medium">
            <li class="flex items-center gap-2">
              <span class="inline-flex w-5 h-5 items-center justify-center rounded-full bg-[var(--color-lime)] border-2 border-[var(--color-ink)] text-[10px] font-bold">✓</span>
              Didukung oleh Formspree, tidak perlu akun
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex w-5 h-5 items-center justify-center rounded-full bg-[var(--color-lime)] border-2 border-[var(--color-ink)] text-[10px] font-bold">✓</span>
              Biasanya membalas dalam beberapa hari
            </li>
          </ul>
        </div>

        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
