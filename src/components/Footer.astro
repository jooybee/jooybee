---
import { site } from "../config/site";

const socials = [
  {
    id: "facebook",
    label: "Facebook",
    href: "https://facebook.com/jooybee", // ganti URL-mu
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z"/></svg>`,
  },
  {
    id: "tiktok",
    label: "TikTok",
    href: "https://www.tiktok.com/@jooybee__",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.73a8.18 8.18 0 0 0 4.76 1.52V6.84a4.84 4.84 0 0 1-1-.15z"/></svg>`,
  },
  {
    id: "github",
    label: "GitHub",
    href: "https://github.com/jooybee",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>`,
  },
];
---

<footer class="bg-[var(--color-ink)] text-[var(--color-paper)] border-t-[3px] border-[var(--color-ink)] pt-16 overflow-hidden">
  <div class="container-brutal">
    <!-- Top: brand kiri | nav + sosial kanan (sejajar) -->
    <div class="grid grid-cols-1 md:grid-cols-[1.3fr_2fr] gap-10 pb-12">
      <!-- Brand -->
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-2.5 font-black text-2xl tracking-tight no-underline text-[var(--color-yellow-mark)] mb-3"
        >
        {site.name}
        </a>
        <p class="text-sm text-[#c8c4ba] max-w-[32ch] mt-3 leading-relaxed">
          {site.footer.tagline}
        </p>
      </div>

      <!-- Navigasi + Sosial sejajar -->
      <div class="grid grid-cols-2 gap-8">
        <!-- Navigasi -->
        <div>
          <h3 class="font-mono text-xs font-bold uppercase tracking-[0.1em] text-[var(--color-yellow-mark)] mb-4">
            Navigasi
          </h3>
          <ul class="flex flex-col gap-2.5 list-none m-0 p-0">
            {
              site.nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-[#d9d5cb] no-underline hover:text-[var(--color-yellow-mark)] hover:underline underline-offset-4 decoration-2 transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Sosial (di samping navigasi) -->
        <div>
          <h3 class="font-mono text-xs font-bold uppercase tracking-[0.1em] text-[var(--color-yellow-mark)] mb-4">
            Sosial
          </h3>
          <div class="flex items-center gap-3 flex-wrap">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="inline-flex items-center justify-center w-10 h-10 bg-[var(--color-paper)] text-[var(--color-ink)] border-[2.5px] border-[var(--color-paper)] no-underline hover:bg-[var(--color-yellow-mark)] hover:border-[var(--color-yellow-mark)] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all"
                  set:html={s.icon}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>

   <!-- Giant wordmark JOOYBEE — transparan + outline, ukuran disesuaikan -->
<div
  class="select-none pointer-events-none mt-2 mb-2 font-black leading-[0.75] tracking-[-0.05em] text-transparent overflow-hidden"
  style="font-size: clamp(2.5rem, 11vw + 1rem, 10rem); -webkit-text-stroke: 2px #5c574e; text-stroke: 2px #5c574e;"
  aria-hidden="true"
>
  JOOYBEE
</div>

    <!-- Bottom bar -->
    <div class="border-t-[2px] border-[#38352f] pt-6 pb-8 flex flex-col sm:flex-row justify-between gap-3 font-mono text-xs text-[#a8a399]">
      <span>© {new Date().getFullYear()} JOOYBEE. Enjoy Being Everything.</span>
      <span>
        Made with ❤ by {" "}
         <a href="/about" class="text-[var(--color-yellow-mark)] font-bold no-underline hover:underline underline-offset-4 decoration-2">
          Aji Sasmito
        </a>
      </span>
    </div>
  </div>
</footer>