---
import { site } from "../config/site";
import Button from "./Button.astro";
---

<header class="sticky top-0 z-50 bg-white border-b-[3px] border-[var(--color-ink)]">
  <div class="container-brutal flex items-center justify-between h-[74px]">
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2.5 font-black text-xl tracking-tight no-underline text-[var(--color-ink)]"
    >
      <span
        class="inline-block w-[22px] h-[22px] bg-[var(--color-yellow-mark)] border-[2.5px] border-[var(--color-ink)] shadow-[3px_3px_0_0_var(--color-ink)]"
        aria-hidden="true"
      ></span>
      {site.name}
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-7" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="font-mono text-[0.85rem] font-bold uppercase tracking-[0.04em] text-[var(--color-ink)] no-underline pb-0.5 border-b-[2.5px] border-transparent transition-[border-color] duration-100 hover:border-[var(--color-ink)]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <div class="hidden md:block">
      <Button href={site.cta.primary.href} size="sm">
        {site.cta.primary.label}
      </Button>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      class="md:hidden btn-brutal btn-secondary px-3 py-2 text-sm"
      aria-expanded="false"
      aria-controls="mobile-menu"
      type="button"
    >
      Menu
    </button>
  </div>

  <!-- Mobile panel -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t-[3px] border-[var(--color-ink)] bg-white"
  >
    <nav class="container-brutal flex flex-col gap-4 py-4" aria-label="Mobile">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="font-mono text-base font-bold uppercase tracking-[0.04em] text-[var(--color-ink)] no-underline py-1"
          >
            {item.label}
          </a>
        ))
      }
      <Button href={site.cta.primary.href} class="w-full justify-center">
        {site.cta.primary.label}
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>