---
import { site } from "../config/site";

const items = [...site.logos, ...site.logos];
---

<section class="bg-[var(--color-ink)] border-y-[3px] border-[var(--color-ink)] overflow-hidden py-4 reveal">
  <p class="text-center font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-acid)] mb-3">
    Everything deserves to enjoy bing itself.
  </p>
  <div class="flex animate-marquee whitespace-nowrap">
    {
      items.map((name) => (
        <span class="mx-8 font-mono font-bold text-lg text-white tracking-wider">
          {name}
        </span>
      ))
    }
  </div>
</section>
