---
import { site } from "../config/site";
import FeatureCard from "./FeatureCard.astro";
---

<section id="features" class="section border-y-[3px] border-[var(--color-ink)] reveal">
  <div class="container-brutal">
    <div class="max-w-2xl mb-12">
      <div class="flex items-center gap-2 mb-2">
        <span
          class="inline-block w-3 h-3 bg-[var(--color-bubble)] border-2 border-[var(--color-ink)] shadow-[2px_2px_0_0_var(--color-ink)]"
          aria-hidden="true"
        ></span>
        <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink)]/50 m-0">
          Ada apa disini?
        </p>
      </div>
      <h2 class="text-4xl md:text-5xl font-black tracking-tight leading-tight">
        Semua yang kamu butuhin.<br />Nggak lebih, nggak kurang.
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        site.features.map((f, i) => (
          <FeatureCard title={f.title} description={f.description} index={i} />
        ))
      }
    </div>
  </div>
</section>