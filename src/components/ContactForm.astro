---
import { site } from "../config/site";
import Button from "./Button.astro";
---

<form
  action={site.formspree}
  method="POST"
  class="brutal bg-white p-6 md:p-8 space-y-5 max-w-xl"
>
  <input type="hidden" name="_subject" value="JOOYBEE contact" />

  <div>
    <label for="name" class="block font-bold text-sm mb-1.5">Name</label>
    <input
      id="name"
      type="text"
      name="name"
      required
      class="w-full brutal-sm bg-[var(--color-paper)] px-3 py-2.5 outline-none focus:bg-white"
      autocomplete="name"
    />
  </div>

  <div>
    <label for="email" class="block font-bold text-sm mb-1.5">Email</label>
    <input
      id="email"
      type="email"
      name="email"
      required
      class="w-full brutal-sm bg-[var(--color-paper)] px-3 py-2.5 outline-none focus:bg-white"
      autocomplete="email"
    />
  </div>

  <div>
    <label for="message" class="block font-bold text-sm mb-1.5">Message</label>
    <textarea
      id="message"
      name="message"
      required
      rows="6"
      class="w-full brutal-sm bg-[var(--color-paper)] px-3 py-2.5 outline-none focus:bg-white resize-y min-h-[140px]"
    ></textarea>
  </div>

  <!-- Formspree honeypot -->
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

  <Button type="submit" variant="primary" class="w-full justify-center">
    Send message →
  </Button>

  <p class="font-mono text-xs text-[var(--color-ink)]/50">
    Sent via Formspree. No tracking, no newsletter signup unless you ask.
  </p>
</form>
