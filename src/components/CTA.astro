---
import { site } from "../config/site";
import Button from "./Button.astro";
---

<section class="section bg-[var(--color-ink)] text-white border-y-[3px] border-[var(--color-ink)]">
  <div class="container-brutal text-center max-w-2xl mx-auto">
    <h2 class="text-4xl md:text-5xl font-black tracking-tight mb-4 text-white">
      {site.footer.tagline}
    </h2>
    <p class="text-white/70 mb-8 text-lg">
      Plug Slab in today and see your first real numbers before lunch.
    </p>
    <Button href={site.cta.primary.href} variant="acid" size="lg">
      {site.cta.primary.label}
      <span aria-hidden="true">→</span>
    </Button>
  </div>
</section>
