---
import { site } from "../config/site";
import PricingCard from "./PricingCard.astro";
---

<section id="pricing" class="section">
  <div class="container-brutal">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="flex items-center justify-center gap-2 mb-2">
       <span
        class="inline-block w-3 h-3 bg-[var(--color-bubble)] border-2 border-[var(--color-ink)] shadow-[2px_2px_0_0_var(--color-ink)]" aria-hidden="true"
       ></span>
        <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink)]/50 m-0">
         Pricing
        </p>
</div>
      <h2 class="text-4xl md:text-5xl font-black tracking-tight leading-tight mb-3">
        Honest pricing. Like everything else here.
      </h2>
      <p class="text-[var(--color-ink)]/70">
        Billed monthly. Cancel any time — we won't make you email support to do it.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 items-stretch">
      {
        site.pricing.map((plan) => (
          <PricingCard
            name={plan.name}
            price={plan.price}
            period={plan.period}
            description={plan.description}
            features={plan.features}
            cta={plan.cta}
            href={plan.href}
            featured={plan.featured}
            badge={"badge" in plan ? plan.badge : undefined}
          />
        ))
      }
    </div>
  </div>
</section>
