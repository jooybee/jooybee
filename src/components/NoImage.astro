---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = "", label = "NO IMAGE" } = Astro.props;
---

<div
  class={`relative flex items-center justify-center bg-[var(--color-paper-2)] border-[3px] border-[var(--color-ink)] overflow-hidden ${className}`}
  role="img"
  aria-label={label}
>
  <!-- Background shape besar di pojok kanan atas -->
  <div
    class="absolute -top-8 -right-8 w-32 h-32 bg-[var(--color-yellow-mark)] border-[3px] border-[var(--color-ink)] rotate-12"
  ></div>

  <!-- Shape kecil di kiri bawah -->
  <div
    class="absolute -bottom-4 -left-4 w-16 h-16 bg-[var(--color-bubble)] border-[3px] border-[var(--color-ink)] -rotate-6"
  ></div>

  <!-- Shape kecil di kanan bawah -->
  <div
    class="absolute bottom-3 right-4 w-8 h-8 bg-[var(--color-tangerine)] border-[2.5px] border-[var(--color-ink)]"
  ></div>

  <!-- Label di tengah -->
  <span
    class="relative z-10 font-mono text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-ink)] bg-[var(--color-paper)] px-3 py-1.5 border-[2.5px] border-[var(--color-ink)] shadow-[3px_3px_0_0_var(--color-ink)]"
  >
    {label}
  </span>
</div>