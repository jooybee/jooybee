---
import { site } from "../config/site";
---

<section id="faq" class="section border-y-[3px] border-[var(--color-ink)]">
  <div class="container-brutal max-w-3xl">
    <div class="mb-10">
      <div class="flex items-center gap-2 mb-2">
       <span
        class="inline-block w-3 h-3 bg-[var(--color-bubble)] border-2 border-[var(--color-ink)] shadow-[2px_2px_0_0_var(--color-ink)]"aria-hidden="true"
       ></span>
        <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink)]/50 m-0">
          FAQ
        </p>
      </div>
      <h2 class="text-4xl md:text-5xl font-black tracking-tight">
        Kamu taya. Saya jawab.
      </h2>
    </div>

    <div class="space-y-3">
      {
        site.faq.map((item) => (
          <details class="brutal bg-white group">
            <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none font-bold text-base select-none">
              <span>{item.q}</span>
              <span
                class="shrink-0 w-7 h-7 flex items-center justify-center border-2 border-[var(--color-ink)] bg-[var(--color-acid)] font-mono text-sm group-open:rotate-45 transition-transform"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="px-5 pb-5 text-sm leading-relaxed text-[var(--color-ink)]/80 border-t-[2px] border-[var(--color-ink)]/10 pt-3">
              {item.a}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
